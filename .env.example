# RelayGate environment variables (placeholders — copy to .env and fill in)
# Never commit the real .env; it is excluded by .gitignore.

# Supabase project URL, from Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key, from Project Settings -> API -> anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
